# Real Laravel API. Use the /api base because website feature code calls paths like /home and /courses.
# Mock API is disabled and must not be used anywhere in the project.
API_BASE_URL=https://medical-courses.mustafafares.com/api
NEXT_PUBLIC_API_BASE_URL=https://medical-courses.mustafafares.com/api

# Public production website URL used for canonical URLs, sitemap, robots, Open Graph, and structured data.
NEXT_PUBLIC_SITE_URL=https://dr-iyas.com

# Optional search-engine ownership verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
